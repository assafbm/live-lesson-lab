# Optional. Set this when the web app and signaling server use separate hosts.
# Example: wss://your-signaling-service.example/signal
# Leave unset during local development to use Vite's /signal proxy.
VITE_SIGNALING_URL=

# Required together for production. Copy public values from CDK outputs.
# Leave all three unset for anonymous loopback development only.
VITE_AUTH_AUTHORITY=
VITE_AUTH_CLIENT_ID=
VITE_AUTH_DOMAIN=

# Optional cloud recording service. Copy RecordingsApiUrl from CDK outputs.
VITE_RECORDINGS_API_URL=
